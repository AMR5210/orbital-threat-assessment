# Copy to .env (gitignored, never committed) and fill in real values.
# Loaded via python-dotenv rather than relying on ambient/`setx`
# environment variables -- those don't reliably propagate into every
# tool execution context, while a file on disk always does. See
# README.md's credential setup section for the full walkthrough.

# --- Anthropic (Stage 7 agent) ---
ANTHROPIC_API_KEY=

# --- Snowflake (Stages 8-9) — key-pair auth, not password ---
# SNOWFLAKE_ACCOUNT is dbt-snowflake's combined "org-account" identifier
# (different shape from Terraform's split organization_name/account_name
# provider fields — see dbt/profiles.yml's comment on this).
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_DATABASE=ORBITAL_THREAT_ASSESSMENT
SNOWFLAKE_WAREHOUSE=OTDA_WH
SNOWFLAKE_SCHEMA=ANALYTICS

# Terraform's org/account/user/key-path have real defaults in
# terraform/variables.tf -- override via TF_VAR_snowflake_* only if
# your account differs. Note: Terraform's provider needs an explicit
# authenticator = "SNOWFLAKE_JWT" to use private_key (dbt-snowflake
# auto-detects key-pair auth instead and has no such field) -- see
# terraform/README.md.

# --- AWS (Stage 9) ---
# Credentials themselves are populated via `aws configure` into
# ~/.aws/credentials instead of here — boto3/sagemaker/AWS CLI all read
# that file natively. These two ARE needed here though: they configure
# otda.logging_backend's DynamoDB hook (no-op if OTDA_DYNAMODB_TABLE is
# unset), not authentication.
AWS_REGION=us-east-2
OTDA_DYNAMODB_TABLE=otda-predictions
